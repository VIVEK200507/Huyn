---
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
---
<BaseLayout title="Gallery">
  <section class="pt-32 pb-24 px-6 bg-cream">
    <p class="text-xs tracking-[0.18em] uppercase text-terracotta text-center mb-2">A look inside</p>
    <h1 class="font-display font-semibold text-4xl text-forest text-center mb-14">Gallery</h1>
    <GalleryGrid />
    <p class="text-center text-sm text-[#8a8368] mt-8">These tiles are placeholders — real photography goes here.</p>
  </section>
</BaseLayout>
