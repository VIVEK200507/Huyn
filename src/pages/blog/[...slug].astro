---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, date, excerpt } = post.data;
const { Content } = await render(post);
const formatted = new Date(date).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
---
<BaseLayout title={title} description={excerpt}>
  <article class="pt-32 pb-24 px-6 bg-cream max-w-2xl mx-auto">
    <p class="text-xs tracking-[0.18em] uppercase text-terracotta mb-2">{formatted}</p>
    <h1 class="font-display font-semibold text-4xl text-forest mb-8">{title}</h1>
    <div class="prose-content text-[#4B4636] font-light leading-relaxed space-y-4">
      <Content />
    </div>
    <a href="/blog" class="inline-block mt-12 text-sm uppercase tracking-wide text-forest hover:text-terracotta transition-colors">
      &larr; Back to Blog
    </a>
  </article>
</BaseLayout>
