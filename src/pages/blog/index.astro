---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPostCard from "../../components/BlogPostCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---
<BaseLayout title="Blog">
  <section class="pt-32 pb-24 px-6 bg-cream">
    <p class="text-xs tracking-[0.18em] uppercase text-terracotta text-center mb-2">Notes from the cafe</p>
    <h1 class="font-display font-semibold text-4xl text-forest text-center mb-14">Blog</h1>

    <div class="max-w-2xl mx-auto">
      {posts.map((post) => <BlogPostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
