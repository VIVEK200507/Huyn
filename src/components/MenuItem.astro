---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

interface Props {
  item: CollectionEntry<"menu">;
  showDot?: boolean;
  image?: string;
  reverse?: boolean; // true = image on the right (for the zig-zag layout)
}
const { item, showDot = true, image, reverse = false } = Astro.props;
const { name, price, veg, note } = item.data;
const { Content } = await render(item);
---
<div class={`mb-6 ${image ? `flex gap-4 items-start ${reverse ? "flex-row-reverse" : ""}` : ""}`}>
  {image && (
    <img
      src={image}
      alt={name}
      width="88"
      height="88"
      loading="lazy"
      class="w-[72px] h-[72px] object-contain shrink-0 -mt-1"
    />
  )}
  <div class={`flex-1 ${reverse ? "text-right" : ""}`}>
    <div class={`flex items-baseline gap-2 ${reverse ? "flex-row-reverse" : ""}`}>
      {showDot && <span class={veg ? "dot-veg relative -top-0.5 shrink-0" : "dot-nonveg relative -top-0.5 shrink-0"}></span>}
      <h4 class="font-medium tracking-wide uppercase text-[1.02rem]">{name}</h4>
      <span class={reverse ? "mr-auto font-display font-semibold text-forest" : "ml-auto font-display font-semibold text-forest"}>{price === "TODO" ? "—" : price}</span>
    </div>
    <p class={`mt-1 text-sm leading-relaxed text-[#5c5646] font-light ${showDot && !image ? "pl-[1.55rem]" : ""}`}>
      <Content />
    </p>
    {note && <p class="text-center font-script text-terracotta text-xl mt-2">{note}</p>}
  </div>
</div>