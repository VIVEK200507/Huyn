---
import Logo from "./Logo.astro";
---
<nav id="site-nav" class="fixed top-0 left-0 right-0 z-20 flex items-center justify-between px-6 py-4 opacity-0 -translate-y-3 pointer-events-none">
  <a href="/" aria-label="Huyn Cafe home">
    <Logo size="sm" />
  </a>
  <div id="nav-links" class="flex gap-6 text-sm tracking-wide uppercase text-forest transition-colors duration-300">
    <a href="/menu" class="hover:text-terracotta transition-colors">Menu</a>
    <a href="/gallery" class="hover:text-terracotta transition-colors">Gallery</a>
    <a href="/events" class="hover:text-terracotta transition-colors">Events</a>
  </div>
</nav>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const nav = document.getElementById("site-nav");
    const navLinks = document.getElementById("nav-links");
    const hero = document.getElementById("hero");

    if (!hero) {
      nav?.classList.remove("opacity-0", "-translate-y-3", "pointer-events-none");
      return;
    }

    const setColor = (overDarkBg: boolean) => {
      if (!navLinks) return;
      navLinks.classList.toggle("text-cream", overDarkBg);
      navLinks.classList.toggle("text-forest", !overDarkBg);
    };

    setColor(true);

    const observer = new IntersectionObserver(
      ([entry]) => setColor(entry.isIntersecting),
      { threshold: 0.1 }
    );
    observer.observe(hero);
  });
</script>